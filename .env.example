# Database
DATABASE_PATH=./data/leads.db

# Webshare.io Proxies
WEBSHARE_API_KEY=your_api_key_here
PROXY_COUNT=50

# API Keys (comma-separated)
REDDIT_API_KEYS=client_id1:client_secret1,client_id2:client_secret2
PRODUCTHUNT_API_KEYS=token1,token2,token3
GITHUB_API_KEYS=ghp_token1,ghp_token2,ghp_token3

# Rate Limits (requests per minute)
RATE_LIMIT_HACKERNEWS=100
RATE_LIMIT_REDDIT=60
RATE_LIMIT_PRODUCTHUNT=100
RATE_LIMIT_GITHUB=300
RATE_LIMIT_WELLFOUND=20
RATE_LIMIT_TECHCRUNCH=30

# Scraping Config
MAX_CONCURRENT_SCRAPERS=6
BATCH_SIZE=100
MAX_LEADS_TARGET=150000
SCRAPE_DURATION_HOURS=48

# Scoring
MIN_RELEVANCE_SCORE=5
ICP_KEYWORDS=linkedin ghostwriting,AI content automation,personal branding,thought leadership,SaaS GTM,LinkedIn marketing,AI content marketing,content automation system,SaaS LinkedIn growth,AI growth system

# Export
EXPORT_PATH=./data/exports/
EXPORT_FILENAME=b2b_leads_{timestamp}.csv

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/scraper.log

# Performance
CONNECTION_POOL_SIZE=100
REQUEST_TIMEOUT=120
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
